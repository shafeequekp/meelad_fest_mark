# ---------------------------------------------------------------------------
# Meelad Django backend configuration.
# meelad/settings.py auto-loads a root .env file when present; on Render the
# dashboard environment always takes precedence. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Django core
SECRET_KEY=generate-a-long-random-string
# DEBUG=0
# ALLOWED_HOSTS=.onrender.com
# Optional comma-separated trusted origins for https POSTs (admin/login):
# e.g. https://meelad-web.onrender.com
CSRF_TRUSTED_ORIGINS=

# --- Neon Postgres (free tier) ---------------------------------------------
# Use the POOLED connection string (hostname contains "-pooler") on Render:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- AI assistant service (separate FastAPI deployment) ---------------------
# Local dev:  http://127.0.0.1:8100
# Render:     https://meelad-fest-mark-ai.onrender.com  (live deployment)
MEELAD_AI_SERVICE_BASE_URL=http://0.0.0.0:8100
# Shared service-to-service secret; must equal MEELAD_SERVICE_TOKEN in the AI service
MEELAD_AI_SERVICE_TOKEN=dev-ai-service-token
MEELAD_AI_CHAT_TIMEOUT=110

# --- Initial superuser (bootstrap_superuser management command) -------------
# Runs automatically in the Render build. Set these in the Render dashboard too.
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-strong-password
# BOOTSTRAP_SUPERUSER_RESET=1   # also reset an existing superuser's password

# Force production settings even when meelad/local.py exists (optional)
MEELAD_ENV=



CLOUDINARY_CLOUD_NAME=ddddddddd
CLOUDINARY_API_KEY=11111111111111
CLOUDINARY_API_SECRET=oxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# # Cashfree config for prod
CASHFREE_CLIENT_ID = xxxxxxxxxxxxxxxxxxxx
CASHFREE_CLIENT_SECRET = xxxxxxxxxxxxxxxxxxxxx
CASHFREE_API_BASE = xxxxxxxxxxxxxxxxxxxxx
CASHFREE_API_VERSION = xxxxxxxxxxxxxxxxxxxxx
# Example webhook secret (same as client secret or separate webhook secret from dashboard)
CASHFREE_WEBHOOK_SECRET = xxxxxxxxxxxxxxxxxxxxx

